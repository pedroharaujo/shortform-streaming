# Example-only values for reviewing this composition with
# `tofu fmt` / `tofu validate`. Copy to a gitignored staging.tfvars
# before any apply.
#
# This file is NOT a D-020 (residency/retention), D-024 (legal-entity
# country), or D-025 (registration details) approval.
# These are NOT a real GCP project ID or billing account ID.
# Copy to a gitignored staging.tfvars before apply (P5-T01-B / #71).
#
# The real GitHub owner/repo belongs in that gitignored copy and in
# docs/runbooks/staging-deploy.md, not in committed .tf files.

project_id         = "example-only"
region             = "changeme"
billing_account_id = "canonical-placeholder-only"

artifact_registry_repository_id = "example-only"
private_bucket_name             = "example-only-nonvideo-changeme"
cloud_run_service_name          = "example-only"

# Artifact Registry path form with an unapplied placeholder tag.
# Not a public hello-world image. The hostname prefix is not a D-020 region.
cloud_run_image = "changeme-docker.pkg.dev/example-only/example-only/shortform-api:unapplied-placeholder"

# Probe Host is localhost. Include 127.0.0.1 and localhost so Django does not 400.
django_allowed_hosts = "127.0.0.1,localhost,.a.run.app,example-only.example"
firebase_project_id  = "example-only"
firebase_app_check_mode   = "disabled"
firebase_app_check_app_id = ""
video_provider       = ""

github_repository  = "example-org/example-repo"
github_environment = "staging"

secret_ids       = ["bunny-stream-api-key", "django-secret-key", "database-url"]
extra_secret_ids = []

# P5-T04: selectors only, never secret values. Empty preserves latest.
# Before rotation, pin EVERY active secret to its verified numeric version.
# Example: secret_versions = { DJANGO_SECRET_KEY = "1", DATABASE_URL = "2" }
secret_versions = {}
# To enable Bunny, also supply bunny_stream_library_id and
# bunny_stream_cdn_hostname; create the consumed token-key name explicitly via
# extra_secret_ids. The two configurable *_key_secret inputs select secret IDs.
# Optional extras are not readable by runtime unless actually consumed.

# Tiny example-only amount. Currency code is not a D-022 EUR approval.
budget_amount_units  = "1"
budget_currency_code = "XXX"
