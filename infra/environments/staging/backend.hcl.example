# Example-only partial GCS backend config.
# Copy to backend.hcl locally (gitignored). Do not commit a real bucket name.
#
# GCS encrypts objects at rest by default. KMS/CMEK for state was not added
# in P5-T01-B / GitHub issue #71. The state bucket is NOT managed by this
# staging composition; bootstrap it with gcloud (see
# docs/runbooks/staging-apply.md).

bucket = "example-only-tofu-state-changeme"
prefix = "environments/staging"
