# Safe local-development values only. Copy to .env; never commit a populated .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=example-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,[::1]
DATABASE_URL=postgresql://shortform@127.0.0.1:5432/shortform
DATABASE_CONNECT_TIMEOUT=2
POSTGRES_DB=shortform
POSTGRES_USER=shortform
POSTGRES_PORT=5432

# Mobile (Expo). EXPO_PUBLIC_* values are embedded in the public JavaScript
# bundle: never place a secret, key, token, or credential in one of them.
# All three variables are required; the app fails loudly instead of defaulting.
# Expo CLI loads them from `mobile/.env` (copy these three lines there).
# Android emulator host is 10.0.2.2; iOS simulator host is 127.0.0.1.
# Catalog territory is ISO 3166-1 alpha-2 and is never inferred from locale.
EXPO_PUBLIC_API_ENVIRONMENT=local
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_CATALOG_TERRITORY=FR

# Playback (P2-T05). Local and CI default to the in-memory Fake provider.
# Production must not use fake. Leave Bunny values empty unless you are running
# a non-production spike; never commit real keys. Optional JSON map:
# PLAYBACK_SPIKE_ASSETS={"ep_public_id":"provider-asset-id"}
VIDEO_PROVIDER=fake
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
