# Safe local-development values only. Copy to .env; never commit a populated .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=example-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,[::1]
DATABASE_URL=postgresql://shortform@127.0.0.1:5432/shortform
DATABASE_CONNECT_TIMEOUT=2
# CONN_MAX_AGE=0
POSTGRES_DB=shortform
POSTGRES_USER=shortform
POSTGRES_PORT=5432

# Mobile (Expo). EXPO_PUBLIC_* values are embedded in the public JavaScript
# bundle: never place a secret, key, token, or credential in one of them.
# Both variables are required; the app fails loudly instead of defaulting.
# Expo CLI loads them from `mobile/.env` (copy these two lines there).
# Android emulator host is 10.0.2.2 (ads-only MVP, D-027).
EXPO_PUBLIC_API_ENVIRONMENT=local
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Firebase (backend). Local/CI default is mock ID-token verification.
# Do not commit service-account JSON or real project credentials.
# Android development-build loop (P2-T01-F1): FIREBASE_AUTH_MODE=admin and
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099. Keep mock for Jest/CI.
FIREBASE_AUTH_MODE=mock
FIREBASE_PROJECT_ID=demo-shortform-local
# Rewarded ads. Keep disabled unless intentionally testing or activating ads.
# Production mode requires a publisher-owned unit and server-side verification.
REWARDED_ADS_MODE=disabled
# REWARDED_ADS_UNIT_ID=ca-app-pub-0000000000000000/0000000000
# Optional: only when running firebase-admin against the Auth emulator.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Playback (P2-T05 / P2-T06). Local and CI default to the in-memory Fake provider.
# Production must not use fake. Leave Bunny values empty unless you are running
# a configured environment; never commit real keys.
# PLAYBACK_SPIKE_ASSETS is obsolete: authorize uses the episode's ready MediaAsset.
VIDEO_PROVIDER=fake
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=

# Django Admin-managed video ingestion. Local defaults to an in-process fake.
# Production uses a private GCS landing bucket; never make that bucket public.
STAFF_UPLOAD_STORE=fake
STAFF_UPLOAD_GCS_BUCKET=
STAFF_UPLOAD_URL_TTL_SECONDS=600

# Public Android switches. Local defaults are test ads + consent-gated analytics.
# Production defaults both off and requires explicit activation.
# EXPO_PUBLIC_REWARDED_ADS_MODE=disabled
# EXPO_PUBLIC_ANALYTICS_ENABLED=false
# Optional paired public AdMob identifiers. Leave both unset for Google demo IDs
# in local test mode; production mode requires a non-demo same-publisher pair.
# Fictional same-publisher examples; supply actual IDs through the process environment.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-1111111111111111~3333333333
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-1111111111111111/2222222222
