# P5-T05-F4 / #121: hosted Android no-charge test release.
# Copy to a private build environment only after hosted-service activation approval.
# Replace both placeholders using the existing test service and RevenueCat app.
# Keep the existing Android package, Firebase project and Play product registry.
EXPO_PUBLIC_API_ENVIRONMENT=staging
EXPO_PUBLIC_API_BASE_URL=https://replace-with-approved-cloud-run-service-url
EXPO_PUBLIC_FIREBASE_AUTH_MODE=cloud
EXPO_PUBLIC_FIREBASE_APP_CHECK_MODE=enforce
EXPO_PUBLIC_COIN_PURCHASE_MODE=revenuecat_sandbox
EXPO_PUBLIC_REVENUECAT_ANDROID_SDK=replace-with-existing-public-google-sdk-identifier
EXPO_PUBLIC_REWARDED_ADS_MODE=disabled
EXPO_PUBLIC_ANALYTICS_ENABLED=false
# Android release bundling sets NODE_ENV=production and __DEV__=false.
# Neither changes EXPO_PUBLIC_API_ENVIRONMENT; production checkout stays disabled.
